{
    "name": "proxy-chakhdi-local",
    "version": "1.0.0",
    "description": "Custom Node.js HTTPS Proxy with Live Web Dashboard",
    "main": "server.js",
    "bin": "server.js",
    "pkg": {
        "assets": [
            "public/**/*",
            "tools/**/*",
            ".env.example"
        ]
    },
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "build": "pkg . --targets node18-win-x64 --output dist/chakhdi-proxy.exe"
    },
    "keywords": [
        "proxy",
        "https",
        "websocket",
        "dashboard"
    ],
    "author": "Chakhdi.local",
    "license": "MIT",
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "dns2": "^2.1.0",
        "dotenv": "^17.2.3",
        "express-rate-limit": "^8.2.2",
        "http-proxy": "^1.18.1",
        "node-forge": "^1.4.0",
        "socket.io": "^4.6.1",
        "sqlite3": "^6.0.1"
    },
    "devDependencies": {
        "nodemon": "^3.0.2"
    }
}
